NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required for ticket intake, the dashboard, and department changes.
# Never prefix this with NEXT_PUBLIC_. It bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to open the dashboard and change tickets.
# Sign-in uses Supabase Auth (email + password). Anyone not on this list is rejected.
OPERATOR_EMAILS=you@company.com

OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Optional. Public POST /api/tickets limit per IP. Defaults: 10 requests / 60 seconds.
# TICKET_INTAKE_RATE_LIMIT=10
# TICKET_INTAKE_RATE_WINDOW_SECONDS=60
